# Khata Ledger Backend — Environment Configuration
# Copy this file to backend/.env and fill in real values. Never commit .env
# itself — it's already in .gitignore.

PORT=8080
NODE_ENV=development

# Generate a real random secret for production, e.g.:
#   node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
JWT_SECRET=replace_with_a_long_random_secret

# The backend currently persists everything to a local SQLite file
# (backend/khata_ledger.db) regardless of this value — Supabase/Postgres
# support is not wired up yet, so leave this as sqlite.
DB_PROVIDER=sqlite
SQLITE_DB_PATH=./khata_ledger.db

# -----------------------------------------------------------------
# Gemini AI (Receipt OCR + Natural Language Entry + Voice Transcription) — optional
# -----------------------------------------------------------------
# Never prefix with VITE_ — that would ship it inside the frontend bundle,
# where it's trivially extractable from the built app.
# Leave blank to disable AI assist; the app falls back to manual entry and
# the local rule-based NLP parser.
GEMINI_API_KEY=

# -----------------------------------------------------------------
# Supabase (not wired into the running app yet — backend/src/config/supabase.js
# is currently unused dead code; db.js always uses SQLite) — optional
# -----------------------------------------------------------------
SUPABASE_URL=
SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=
SUPABASE_DB_URL=
