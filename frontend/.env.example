# Khata Ledger Frontend — Environment Configuration
# Copy this file to frontend/.env if you want to point at a different API
# (e.g. your local backend during development). Never commit .env itself.

# Inlined into the built JS bundle at build time (Vite only exposes VITE_-
# prefixed vars to client code) — never put secrets here.
# Defaults to the production Render backend if left unset — see
# src/services/apiClient.js.
VITE_API_BASE_URL=http://localhost:8080/api/v1
