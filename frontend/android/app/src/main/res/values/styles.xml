<?xml version="1.0" encoding="utf-8"?>
<resources xmlns:tools="http://schemas.android.com/tools">

    <style name="AppTheme" parent="Theme.AppCompat.DayNight.NoActionBar">
        <item name="colorPrimary">@color/colorPrimary</item>
        <item name="colorPrimaryDark">@color/colorPrimaryDark</item>
        <item name="colorAccent">@color/colorAccent</item>
    </style>

    <style name="AppTheme.NoActionBar" parent="Theme.AppCompat.DayNight.NoActionBar">
        <item name="windowActionBar">false</item>
        <item name="windowNoTitle">true</item>
        <item name="android:background">@null</item>
    </style>

    <style name="AppTheme.NoActionBarLaunch" parent="Theme.SplashScreen">
        <item name="android:background">@drawable/splash</item>
        <item name="postSplashScreenTheme">@style/AppTheme.NoActionBar</item>

        <!--
          Android 16 (API 36) forces edge-to-edge for apps targeting it, which
          would draw this WebView underneath the status and navigation bars.
          The web layer already handles its own insets via env(safe-area-inset-*),
          so opt out and keep the bars opaque. Remove this once the layout is
          migrated to full edge-to-edge: the flag stops being honoured at
          targetSdk 37.
        -->
        <item name="android:windowOptOutEdgeToEdgeEnforcement" tools:targetApi="35">true</item>
        <item name="android:statusBarColor">@color/bgSurface</item>
        <item name="android:navigationBarColor">@color/bgSurface</item>
    </style>
</resources>
