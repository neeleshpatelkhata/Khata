<?xml version="1.0" encoding="utf-8"?>
<!--
  Android 12+ (API 31) replacement for full-backup-content.

  cloud-backup  — Google Drive auto backup.
  device-transfer — direct device-to-device migration when buying a new phone.

  Both keep the WebView storage that holds the ledger, and drop caches.
-->
<data-extraction-rules>
    <cloud-backup>
        <include domain="file" path="app_webview/" />
        <include domain="sharedpref" path="." />
        <exclude domain="file" path="app_webview/Default/Cache/" />
        <exclude domain="file" path="app_webview/Default/Code Cache/" />
        <exclude domain="file" path="app_webview/Default/GPUCache/" />
        <exclude domain="cache" path="." />
    </cloud-backup>

    <device-transfer>
        <include domain="file" path="app_webview/" />
        <include domain="sharedpref" path="." />
        <exclude domain="cache" path="." />
    </device-transfer>
</data-extraction-rules>
