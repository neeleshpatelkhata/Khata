# Khata Ledger Enterprise Environment Configuration
# Copy this file to .env and fill in real values. Never commit .env itself —
# it's already in .gitignore.

PORT=8080
NODE_ENV=development

# Generate a real random secret for production, e.g.:
#   node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
JWT_SECRET=replace_with_a_long_random_secret

# The backend currently persists everything to a local SQLite file
# (backend/khata_ledger.db) regardless of this value — Supabase/Postgres
# support is not wired up yet, so leave this as sqlite.
DB_PROVIDER=sqlite
SQLITE_DB_PATH=./backend/khata_ledger.db

# -----------------------------------------------------------------
# Gemini AI (Receipt OCR + Natural Language Entry) — optional
# -----------------------------------------------------------------
# Server-side ONLY — do not prefix with VITE_, or Vite will inline it into
# the client bundle where it can be extracted from the shipped APK.
# Leave blank to disable AI assist; the app falls back to manual entry and
# the local rule-based NLP parser.
GEMINI_API_KEY=
