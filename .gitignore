# Dependencies
node_modules/

# Production build outputs
dist/
build/

# Environment files
.env
.env.local

# Database files
backend/*.db
*.db

# Uploads and backups
uploads/
backups/

# Android build outputs & local properties
frontend/android/.gradle/
frontend/android/build/
frontend/android/app/build/
frontend/android/local.properties

# Release signing material — never commit these. Losing them means you can
# never publish an update to the Play listing again, so back them up offline.
frontend/android/keystore.properties
frontend/android/app/release.keystore
*.jks
*.keystore

# Local one-off keystore/build helper scripts with a hardcoded signing
# password — kept device-local, never pushed.
frontend/android/app/create_keystore.bat
frontend/android/build_release_aab.bat
frontend/android/run_build.bat
frontend/generate_keystore.js

# Build artefacts
*.apk
*.aab

# IDE & System files
.vscode/
.idea/
.DS_Store
Thumbs.db
